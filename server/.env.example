# API port
PORT=5000
# Front-end origin allowed by CORS
CLIENT_URL=http://localhost:5173
# CHANGE THIS to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# PostgreSQL. Leave empty to use the built-in in-memory PostgreSQL engine (pg-mem) - zero setup, data resets on restart.
# Example: postgres://postgres:postgres@localhost:5432/mbono_recruitment
DATABASE_URL=

# Email (optional). Without SMTP settings, emails are printed to the terminal and stored in the admin "Email log".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MBONO Recruitment Services <no-reply@mbono.co.za>"

# Chatbot AI (optional). Without a key the built-in assistant answers FAQs and searches live vacancies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
